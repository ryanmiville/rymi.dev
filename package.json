{
  "name": "rymi.dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180",
    "build": "node scripts/production.mjs build",
    "preview": "vite preview --host 0.0.0.0 --port 5180",
    "postinstall": "void prepare",
    "typecheck": "void prepare && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "og": "node scripts/generate-og.mjs",
    "verify": "npm run typecheck && npm run build && npm test",
    "deploy": "node scripts/production.mjs deploy"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@void/md": "1.2.1",
    "@void/react": "1.2.1",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "void": "1.2.1"
  }
}
